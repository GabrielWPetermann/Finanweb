<?xml version="1.0" encoding="UTF-8"?>
<!--
  Schema da consulta de inadimplencia: o setor de Vendas pergunta ao
  Financeiro se um cliente esta em atraso, antes de vender a prazo.

  Um schema, dois elementos raiz: <consultaInadimplencia> (Vendas envia) e
  <respostaInadimplencia> (o Financeiro devolve a quem perguntou). Quem
  pergunta escolhe o id da consulta e a resposta devolve o mesmo id: pelo
  socket as respostas podem chegar fora de ordem, e o id e o que liga uma a
  outra.

  Situacao do cliente na data da consulta:
    ADIMPLENTE    nenhuma conta a receber vencida e em aberto
    INADIMPLENTE  ao menos uma conta a receber em aberto (status PENDENTE)
                  com vencimento anterior a dataConsulta; cada uma vem em
                  <titulos>
    SEM_CADASTRO  o documento nao e cliente do Financeiro

  Quando a consulta e valida mas nao pode ser respondida (banco fora do ar,
  por exemplo), a resposta traz <erro> no lugar do resultado. Uma consulta
  que nem passa no XSD, e por isso pode nao ter id legivel, e respondida em
  texto no chat, como os movimentos recusados.

  Regras de validacao (numeracao dos demais schemas do Finanweb):
    R1  documento do cliente: so digitos, 11 (CPF) ou 14 (CNPJ).
    R3  valores monetarios: decimal de ate 14 digitos, 2 casas, nao negativo.
    R4  datas: xs:date (AAAA-MM-DD).
    R7  origem: letras minusculas, digitos e hifen, comecando por letra.
    R8  referencia do titulo: sem espacos, ate 60 caracteres. Opcional: conta
        lancada direto no Financeiro nao tem referencia de outro sistema.
    R10 id da consulta: letras, digitos, ponto, sublinhado e hifen, ate 64.
    R12 situacao: enumeracao fechada ADIMPLENTE | INADIMPLENTE | SEM_CADASTRO.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:i="urn:finanweb:inadimplencia:1.0"
           targetNamespace="urn:finanweb:inadimplencia:1.0"
           elementFormDefault="qualified"
           attributeFormDefault="unqualified">

  <!-- ===================== Tipos simples ===================== -->

  <!-- R1: CPF (11 digitos) ou CNPJ (14 digitos), so numeros. -->
  <xs:simpleType name="documentoParceiro">
    <xs:restriction base="xs:string">
      <xs:pattern value="\d{11}|\d{14}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- R7: nome do sistema que pergunta, o mesmo do servidor da turma. -->
  <xs:simpleType name="identificadorSistema">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z][a-z0-9\-]{1,29}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- R8: identificador do titulo no sistema de origem. -->
  <xs:simpleType name="referencia">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z0-9][A-Za-z0-9._/\-]{0,59}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- R10: id da consulta, escolhido por quem pergunta. -->
  <xs:simpleType name="idConsulta">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z0-9][A-Za-z0-9._\-]{0,63}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- R12: situacao do cliente (ver significado no topo). -->
  <xs:simpleType name="situacao">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ADIMPLENTE"/>
      <xs:enumeration value="INADIMPLENTE"/>
      <xs:enumeration value="SEM_CADASTRO"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- R3: valor monetario = Decimal(14,2), nao negativo. -->
  <xs:simpleType name="valorMonetario">
    <xs:restriction base="xs:decimal">
      <xs:totalDigits value="14"/>
      <xs:fractionDigits value="2"/>
      <xs:minInclusive value="0"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Motivo de uma consulta nao respondida, em uma linha. -->
  <xs:simpleType name="mensagemErro">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="500"/>
      <xs:pattern value="\S(.*\S)?"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- ===================== Tipos complexos ===================== -->

  <!-- Conta a receber vencida e em aberto. -->
  <xs:complexType name="titulo">
    <xs:sequence>
      <xs:element name="valor" type="i:valorMonetario"/>       <!-- R3 -->
      <xs:element name="vencimento" type="xs:date"/>           <!-- R4 -->
      <xs:element name="diasAtraso" type="xs:positiveInteger"/>
    </xs:sequence>
    <xs:attribute name="referencia" type="i:referencia" use="optional"/>  <!-- R8 -->
  </xs:complexType>

  <!-- Vazio quando o cliente nao tem atraso. -->
  <xs:complexType name="titulos">
    <xs:sequence>
      <xs:element name="titulo" type="i:titulo" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <!-- ===================== Elementos raiz ===================== -->

  <xs:element name="consultaInadimplencia">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="origem" type="i:identificadorSistema"/>  <!-- R7 -->
        <xs:element name="documento" type="i:documentoParceiro"/>  <!-- R1 -->
      </xs:sequence>
      <xs:attribute name="versao" type="xs:string" use="required" fixed="1.0"/>
      <xs:attribute name="id" type="i:idConsulta" use="required"/>  <!-- R10 -->
    </xs:complexType>
  </xs:element>

  <xs:element name="respostaInadimplencia">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="dataConsulta" type="xs:date"/>             <!-- R4 -->
        <xs:choice>
          <xs:sequence>
            <xs:element name="documento" type="i:documentoParceiro"/>  <!-- R1 -->
            <xs:element name="situacao" type="i:situacao"/>            <!-- R12 -->
            <xs:element name="valorEmAtraso" type="i:valorMonetario"/>
            <xs:element name="titulos" type="i:titulos"/>
          </xs:sequence>
          <xs:element name="erro" type="i:mensagemErro"/>
        </xs:choice>
      </xs:sequence>
      <xs:attribute name="versao" type="xs:string" use="required" fixed="1.0"/>
      <xs:attribute name="id" type="i:idConsulta" use="required"/>  <!-- R10 -->
    </xs:complexType>
  </xs:element>

</xs:schema>
