datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
}

enum TipoImportacao {
  ENTRADA
  SAIDA
}

enum TipoParceiro {
  CLIENTE
  FORNECEDOR
}

enum DirecaoMensagem {
  RECEBIDA
  ENVIADA
}

model Usuario {
  id          String       @id @default(cuid())
  username    String       @unique
  senha       String // texto simples -- sem hash, comparacao direta (decisao explicita do projeto)
  nomeEquipe  String       @default("")
  whatsapp    String?
  role        Role         @default(USER)
  ativo       Boolean      @default(true)
  // false = solicitacao de cadastro publica, aguardando aprovacao de um
  // admin. Usuarios criados via /admin/usuarios ja nascem aprovados.
  aprovado    Boolean      @default(true)
  criadoEm    DateTime     @default(now())
  importacoes Importacao[]
}

model Categoria {
  id       String            @id @default(cuid())
  nome     String
  tipo     TipoImportacao
  ativo    Boolean           @default(true)
  criadoEm DateTime          @default(now())
  pedidos  PedidoAgrupado[]
  despesas DespesaAgrupada[]

  @@unique([nome, tipo])
  @@index([tipo])
}

model Parceiro {
  id        String       @id @default(cuid())
  nome      String
  documento String?
  email     String?
  telefone  String?
  tipo      TipoParceiro
  ativo     Boolean      @default(true)
  criadoEm  DateTime     @default(now())
  pedidos   PedidoAgrupado[]
  despesas  DespesaAgrupada[]

  @@unique([documento, tipo])
  @@index([tipo])
  @@index([nome])
}

model Importacao {
  id                  String            @id @default(cuid())
  tipo                TipoImportacao
  nomeArquivo         String
  blobUrl             String
  usuarioId           String
  usuario             Usuario           @relation(fields: [usuarioId], references: [id])
  dataArquivoOriginal DateTime?
  qtdRegistros        Int
  valorTotal          Decimal           @db.Decimal(14, 2)
  criadoEm            DateTime          @default(now())
  pedidos             PedidoAgrupado[]
  despesas            DespesaAgrupada[]
}

model PedidoAgrupado {
  id                 String      @id @default(cuid())
  // Nulo quando o registro foi lancado manualmente na tela (sem CSV).
  importacaoId       String?
  importacao         Importacao? @relation(fields: [importacaoId], references: [id], onDelete: Cascade)
  clienteId          String
  cliente            Parceiro    @relation(fields: [clienteId], references: [id])
  categoriaId        String
  categoria          Categoria   @relation(fields: [categoriaId], references: [id])
  subtotal           Decimal     @db.Decimal(14, 2)
  descontoPercentual Decimal     @db.Decimal(6, 2)
  descontoValor      Decimal     @db.Decimal(14, 2)
  frete              Decimal     @db.Decimal(14, 2)
  valorTotal         Decimal     @db.Decimal(14, 2)
  formaPagamento     String
  dataPedido         DateTime
  status             String

  @@index([clienteId])
  @@index([dataPedido])
  @@index([categoriaId])
}

model DespesaAgrupada {
  id             String      @id @default(cuid())
  // Nulo quando o registro foi lancado manualmente na tela (sem CSV).
  importacaoId   String?
  importacao     Importacao? @relation(fields: [importacaoId], references: [id], onDelete: Cascade)
  fornecedorId   String
  fornecedor     Parceiro    @relation(fields: [fornecedorId], references: [id])
  categoriaId    String
  categoria      Categoria   @relation(fields: [categoriaId], references: [id])
  valor          Decimal     @db.Decimal(14, 2)
  formaPagamento String
  dataPagamento  DateTime
  status         String

  @@index([fornecedorId])
  @@index([dataPagamento])
  @@index([categoriaId])
}

// Mensagens do chat do servidor de socket da disciplina (tela /chat).
// O ouvinte (npm run socket) grava o que chega e manda o que esta na fila:
// a funcao serverless nao fica conectada, entao o banco faz a ponte.
model MensagemChat {
  id        String          @id @default(cuid())
  direcao   DirecaoMensagem
  // RECEBIDA: rotulo de quem mandou no chat ("ana#3", "servidor").
  // ENVIADA: username de quem escreveu no Finanweb (ou "ouvinte").
  autor     String
  // ENVIADA: nome ou id do destinatario; null = todos os conectados.
  destino   String?
  privada   Boolean         @default(false)
  // Linha "[servidor] ..." (entrou, saiu, destino nao encontrado...).
  aviso     Boolean         @default(false)
  texto     String
  criadoEm  DateTime        @default(now())
  // So ENVIADA: quando o ouvinte mandou pelo socket. null = na fila.
  enviadaEm DateTime?

  @@index([criadoEm])
  @@index([direcao, enviadaEm])
}

// Estado do ouvinte, numa linha so (id "ouvinte"): quem esta conectado ao
// servidor de chat, segundo o ultimo /lista. As telas leem daqui em vez de
// abrir uma conexao so para perguntar, o que espalharia "entrou/saiu" no
// chat da turma. atualizadoEm velho = ouvinte fora do ar.
model EstadoOuvinte {
  id           String   @id
  conectados   String[]
  atualizadoEm DateTime @updatedAt
}
